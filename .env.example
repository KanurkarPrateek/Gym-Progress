# Copy to .env for local development, and set the same variables on Vercel.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# The secret key. Server-side only — it never reaches the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Accounts: name:password:accent — comma separated, accent optional.
# Each name gets its own folder in the bucket; accounts cannot see each other's photos.
# Names allow letters, digits, _ and -. Passwords must not contain a comma or colon.
# If unset, the site is WIDE OPEN — always configure accounts in production.
USERS=alice:alice-long-password:#4ade80,bob:bob-long-password:#60a5fa

# Legacy single-account alternative, used only when USERS is unset.
# APP_PASSWORD=choose-something-long
