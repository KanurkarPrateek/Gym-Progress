# Copy to .env for local development, and set the same three on Vercel.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# The secret key. Server-side only — it never reaches the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Password to open the site. If unset, the site is WIDE OPEN — always set it in production.
APP_PASSWORD=choose-something-long
